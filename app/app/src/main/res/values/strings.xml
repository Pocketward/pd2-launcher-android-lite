    <string name="brand_name">Project Diablo 2</string>
    <string name="brand_edition">Launcher Lite</string>

    <!-- The four step marks: Check, Import, Complete, Play. -->
    <string name="step_check">Check</string>
    <string name="step_import">Import</string>
    <string name="step_complete">Complete</string>
    <string name="step_play">Play</string>
    <string name="step_counter">Step %1$d of %2$d</string>

