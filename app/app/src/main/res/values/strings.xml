    <string name="device_checking_title">Checking this device…</string>
    <string name="device_checking_body">Nothing is unpacked until the check passes.</string>
    <string name="not_supported_title">This device is not supported</string>
    <string name="not_supported_body">PD2 Launcher Lite needs an Adreno or a Mali-G310, G610, G615, G715, G720 or G725 GPU, Android 13 or later and 4 KB memory pages.</string>
