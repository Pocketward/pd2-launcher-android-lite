    <string name="device_page_size">Memory pages are %1$d bytes. 4096 is needed.</string>
    <!-- Check's device row: the GPU and the Android version. -->
    <string name="device_summary">%1$s graphics · Android %2$s</string>
    <string name="device_summary_android">Android %1$s</string>

